{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "hyperlane-bullet-validator values",
  "description": "Presence of the required settings is enforced by the templates (helpers.validate), which report a readable error; this schema rejects unknown top-level keys and malformed scalar values. Kubernetes-native lists (imagePullSecrets, extraEnv, extraEnvFrom) are passed through as-is.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "description": "Reserved by Helm for parent charts; unused by this chart."
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "replicaCount": {
      "description": "Fixed at 1: exactly one signer per validator key.",
      "const": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$" },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["", "signer", "readonly"]
        },
        "key": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string", "minLength": 1 },
            "value": {
              "type": "string",
              "pattern": "^((0x)?[0-9a-fA-F]{64})?$"
            }
          }
        }
      }
    },
    "sequencerUrl": {
      "type": "string",
      "pattern": "^(https?://\\S+)?$"
    },
    "wsUrl": {
      "type": "string",
      "pattern": "^(wss?://\\S+)?$"
    },
    "mailboxDomain": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "scanIntervalSecs": {
      "type": "integer",
      "minimum": 1
    },
    "logLevel": { "type": "string", "minLength": 1 },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bucket": { "type": "string", "pattern": "^\\S*$" },
        "region": { "type": "string", "pattern": "^([a-z0-9-]+)?$" },
        "prefix": { "type": "string", "pattern": "^\\S*$" }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metrics": { "$ref": "#/definitions/port" },
        "health": { "$ref": "#/definitions/port" }
      }
    },
    "startupProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodSeconds", "failureThreshold"],
      "properties": {
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": { "type": "object" }
    },
    "prometheusScrapeAnnotations": { "type": "boolean" },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "labels": { "$ref": "#/definitions/stringMap" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "relabelings": {
          "type": "array",
          "items": { "type": "object" }
        },
        "metricRelabelings": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  }
}
